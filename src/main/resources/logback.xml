<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Path and file name (override with -DLOG_PATH=/var/logs/card-offers) -->
    <property name="LOG_PATH" value="./logs" />
    <property name="LOG_FILE_NAME" value="application_logback" />

    <!-- Console appender: useful for container stdout -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ} %-5level [%thread] %logger{36} [%X{correlationId:-n/a}] - %msg%n%ex{full}</pattern>
        </encoder>
    </appender>

    <!-- Rolling file appender: daily files + size-based index, archives compressed -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE_NAME}.log</file>
        <append>true</append>

        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} [%X{correlationId:-n/a}] - %msg%n%ex{full}</pattern>
            <immediateFlush>true</immediateFlush>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- daily files and index when size exceeded; archives gzipped -->
            <fileNamePattern>${LOG_PATH}/archived/${LOG_FILE_NAME}-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Async wrapper for file writing to reduce IO impact on request threads -->
    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>5000</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <appender-ref ref="FILE" />
    </appender>

    <!-- Per-package levels: keep framework noise down, app package INFO in production -->
    <logger name="org.springframework" level="WARN" />
    <logger name="org.apache" level="WARN" />
    <!-- Application package: production default is INFO. Set to DEBUG only when troubleshooting. -->
    <logger name="com.fintech.offers" level="INFO" />

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ASYNC_FILE" />
    </root>


</configuration>